# ─── Speech-to-Text & LLM Provider API Keys (leave empty or fill as needed) ───
SARVAM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Model & Provider Configuration ──────────────────────────────────────────
# Provider auto-detects based on available key if empty ("gemini", "claude", "openai")
LLM_PROVIDER=
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o-mini

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to automatically use absolute path: backend/data/pw_qa.db
DATABASE_URL=

# ─── Security / Demo Access ───────────────────────────────────────────────────
# If set, all mutating API endpoints (POST, PUT, DELETE) require this token
DEMO_ACCESS_TOKEN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for frontend communication
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ─── Application & Pipeline Limits ────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_UPLOAD_MB=200
MAX_AUDIO_MINUTES=120
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,ogg,flac,aac
CACHE_DIR=.cache

# ─── Reviewer Time Assumptions (editable in Overview UI) ──────────────────────
ASSUMPTION_MANUAL_REVIEW_MINUTES=25
ASSUMPTION_AI_ASSISTED_REVIEW_MINUTES=8

# ─── Frontend Environment Variables (Vite) ────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_ACCESS_TOKEN=
